# Bowerbird configuration (copy to bowerbird.env and edit)

# AI goes through Fairlead, the Fleet model router on this PC. Nothing here is a secret:
# the client key is read from Windows Credential Manager (Fairlead/Bowerbird), saved by Fairlead
# ("Install for this app"). All three settings below are optional.

# Fairlead's chat address (must be on this PC):
# BOWERBIRD_FAIRLEAD_URL=http://127.0.0.1:8776/v1/chat/completions
# The Fairlead route name to ask for:
# BOWERBIRD_FAIRLEAD_MODEL=auto
# local = prompts and images stay on local models (default); any = Fairlead may use cloud models.
# Starting Studio or the CLI with -AllowCloudAI sets any for that run.
# BOWERBIRD_FAIRLEAD_PRIVACY=local

# Lifecycle: Studio stops itself when its browser tab closes. 0 keeps it running
# (same as Start-Bowerbird.bat --stay). The environment variable wins over this file.
# BOWERBIRD_AUTO_STOP=1

# Naming / behavior
# BOWERBIRD_PASS1_THRESHOLD=0.65
# BOWERBIRD_MAX_VISION_PER_RUN=25
# BOWERBIRD_DATE_FORMAT=yyyy-MM-dd
