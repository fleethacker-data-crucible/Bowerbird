# Bowerbird configuration (copy to bowerbird.env and edit)
# Tokens preferred from Lazarette vault (ai-endpoint-api / grok-api). Env is fallback.

# LLM profile: Auto | AiEndpoint | Grok
BOWERBIRD_LLM_PROFILE=Auto

# Endpoint URLs
# AiEndpoint defaults to the local phoenix-lai server on this PC (loopback only, model phoenixlai):
#   http://127.0.0.1:1234/v1/chat/completions
# A token is optional there (phoenix-lai's API key is off by default). Set this to use another endpoint:
# BOWERBIRD_AI_ENDPOINT_URL=https://ai.example.org/v1/chat/completions
# Grok is an outside provider with no built-in URL; set this to use it:
# BOWERBIRD_GROK_URL=https://databricks.example.org/serving-endpoints/databricks-grok-4-6/invocations

# Optional overrides (normally leave blank – use Lazarette or profile defaults)
# LLM_URL overrides the endpoint URL for every profile
# LLM_URL=
# LLM_MODEL=
# AI_ENDPOINT_TOKEN=
# DATABRICKS_TOKEN=

# Lazarette integration (same pattern as Halyard / PacketRat). Lazarette is found through the LAZARETTE_PATH
# environment variable, else a Lazarette folder next to Bowerbird, else %USERPROFILE%\Projects\Lazarette.
# Item names: change one only if your vault item has a different name.
# BOWERBIRD_LAZARETTE_ITEM_AiEndpoint=ai-endpoint-api
# BOWERBIRD_LAZARETTE_ITEM_Grok=grok-api

# Lifecycle: Studio stops itself when its browser tab closes. 0 keeps it running
# (same as Start-Bowerbird.bat --stay). The environment variable wins over this file.
# BOWERBIRD_AUTO_STOP=1

# Naming / behavior
# BOWERBIRD_PASS1_THRESHOLD=0.65
# BOWERBIRD_MAX_VISION_PER_RUN=25
# BOWERBIRD_DATE_FORMAT=yyyy-MM-dd
