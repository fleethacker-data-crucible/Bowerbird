# Bowerbird configuration (copy to bowerbird.env and edit)
# Tokens preferred from ARC vault (genapi / advana-api). Env is fallback.

# LLM profile: Auto | GenAi | Grok
BOWERBIRD_LLM_PROFILE=Auto

# Optional overrides (normally leave blank – use ARC or profile defaults)
# LLM_URL=
# LLM_MODEL=
# GENAI_TOKEN=
# DATABRICKS_TOKEN=

# ARC integration (same pattern as Cascade / OutlookFalcon)
# ARC_PATH=C:\Users\YOU\Projects\arc
# BOWERBIRD_ARC_ITEM_GenAi=genapi
# BOWERBIRD_ARC_ITEM_Grok=advana-api

# Naming / behavior
# BOWERBIRD_PASS1_THRESHOLD=0.65
# BOWERBIRD_MAX_VISION_PER_RUN=25
# BOWERBIRD_DATE_FORMAT=yyyy-MM-dd
